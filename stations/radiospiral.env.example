# Per-station settings for the radiospiral monitor. Copy to stations/radiospiral.env.
# Loaded after .env, so anything set here overrides .env.
#
# radiospiral is the main station and the only one with streamers enabled.
# The stream URL below is a placeholder; confirm it before relying on it.
STATION_NAME=radiospiral
STREAM_URL=https://radio.example.com/listen/radiospiral/radio.mp3
AZURACAST_STATION_ID=radiospiral
STATE_DIR=/state
# Streamers enabled is the default; set explicitly for clarity.
STREAMERS_ENABLED=true
