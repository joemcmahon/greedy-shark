# Per-station settings for the inner monitor. Copy to stations/inner.env.
# Loaded after .env, so anything set here overrides .env.
#
# PLACEHOLDERS: the station name/shortcode and stream URL below are guesses.
# Confirm the AzuraCast shortcode and stream URL on the test server.
STATION_NAME=inner
STREAM_URL=https://radio.example.com/listen/inner/radio.mp3
AZURACAST_STATION_ID=inner
STATE_DIR=/state
# Streamer-less station.
STREAMERS_ENABLED=false
